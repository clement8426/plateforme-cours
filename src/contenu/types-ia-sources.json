{
  "lexique": [
    {
      "terme": "IA",
      "nom": "Intelligence artificielle",
      "def": "Un programme qui accomplit une tâche qu’on croyait réservée à l’humain, le plus souvent en apprenant à partir d’exemples.",
      "cle": "definition"
    },
    {
      "terme": "Apprentissage automatique",
      "def": "Une façon de créer un programme : on lui montre des exemples, il en tire lui-même les règles.",
      "cle": "definition"
    },
    {
      "terme": "Réseau de neurones",
      "def": "Un programme fait de nombreuses petites opérations reliées entre elles, réglées pendant l’apprentissage.",
      "cle": "frise"
    },
    {
      "terme": "Modèle",
      "def": "Le résultat de l’apprentissage : le programme entraîné, prêt à faire sa tâche.",
      "cle": "specialisees"
    },
    {
      "terme": "OCR",
      "nom": "OCR, reconnaissance optique de caractères",
      "def": "L’IA qui recopie le texte d’une image ou d’un scan.",
      "cle": "ocr"
    },
    {
      "terme": "Vision",
      "nom": "Vision par ordinateur",
      "def": "Les IA qui analysent une image : la classer, détecter ses objets, détourer leurs contours.",
      "cle": "vision"
    },
    {
      "terme": "Détection d’objets",
      "def": "Trouver chaque objet d’une image, avec un cadre et une étiquette.",
      "cle": "vision"
    },
    {
      "terme": "Donnée biométrique",
      "def": "Donnée issue de caractéristiques physiques ou comportementales. Sensible en Suisse lorsqu’elle identifie une personne de manière unique.",
      "cle": "vision"
    },
    {
      "terme": "Description d’image",
      "nom": "Description d’image (image captioning)",
      "def": "Une phrase qui dit ce que montre une image, produite par un modèle qui relie vision et langage.",
      "cle": "description"
    },
    {
      "terme": "Transcription",
      "nom": "Transcription (STT, speech-to-text)",
      "def": "Changer une voix en texte écrit.",
      "cle": "transcription"
    },
    {
      "terme": "Synthèse vocale",
      "nom": "Synthèse vocale (TTS, text-to-speech)",
      "def": "Changer un texte en voix.",
      "cle": "synthese"
    },
    {
      "terme": "Diffusion",
      "def": "Une technique de génération : transformer progressivement du bruit en image. Tous les générateurs ne l’utilisent pas.",
      "cle": "generation"
    },
    {
      "terme": "LLM",
      "nom": "LLM, grand modèle de langage",
      "def": "Un grand modèle de langage entraîné notamment à prédire des jetons. Il génère des réponses et peut se tromper.",
      "cle": "llm"
    },
    {
      "terme": "Jeton",
      "nom": "Jeton (token)",
      "def": "Une unité de texte : mot, fragment de mot, ponctuation ou espace, selon le découpage du modèle.",
      "cle": "llm"
    },
    {
      "terme": "Paramètres",
      "def": "Les réglages internes d’un modèle, fixés pendant l’apprentissage. Un LLM en compte des milliards.",
      "cle": "llm"
    },
    {
      "terme": "Transformer",
      "def": "L’architecture publiée par Google en 2017, utilisée par de nombreux LLM. Le « T » de GPT.",
      "cle": "transformer"
    },
    {
      "terme": "Hallucination",
      "def": "Un contenu inventé ou sans fondement produit par une IA, quel que soit le ton employé.",
      "cle": "forces"
    },
    {
      "terme": "Multimodal",
      "def": "Se dit d’un assistant qui accepte plusieurs types de données : texte, image, son.",
      "cle": "multimodal"
    },
    {
      "terme": "Local",
      "nom": "En local",
      "def": "Un modèle exécuté sur votre appareil. Vérifiez séparément les envois de l’application, ses outils et ses sauvegardes.",
      "cle": "comparer"
    },
    {
      "terme": "Harnais",
      "def": "Le logiciel qui relie un LLM à des outils, et décide de ce qu’il a le droit de faire.",
