{
  "lexique": [
    {
      "terme": "UX",
      "nom": "UX, User Experience",
      "def": "Ce que l’on vit en utilisant un produit : le parcours et le ressenti.",
      "cle": "ui-ux"
    },
    {
      "terme": "UI",
      "nom": "UI, User Interface",
      "def": "L’interface avec laquelle une personne interagit : présentation, commandes, états et réactions du produit.",
      "cle": "ui-ux"
    },
    {
      "terme": "Cible",
      "def": "Les personnes pour qui l’on conçoit. Une UX se juge toujours par rapport à elles.",
      "cle": "cible"
    },
    {
      "terme": "Persona",
      "def": "Portrait fictif d’un utilisateur type, construit à partir d’observations réelles.",
      "cle": "cible"
    },
    {
      "terme": "SaaS",
      "nom": "SaaS (Software as a Service)",
      "def": "Un logiciel fourni comme service et accessible par le réseau, généralement sur abonnement. Il s’utilise dans un navigateur ou avec une application installée.",
      "cle": "produits"
    },
    {
      "terme": "Activation",
      "def": "L’étape où un nouvel utilisateur obtient une première valeur du produit. Son lien avec la rétention ou le paiement est à vérifier.",
      "cle": "produits"
    },
    {
      "terme": "Rétention",
      "def": "La proportion d’un groupe d’utilisateurs qui réalise de nouveau une action définie, après une période donnée.",
      "cle": "hotjar"
    },
    {
      "terme": "Tunnel de conversion",
      "nom": "Tunnel de conversion (funnel)",
      "def": "Le parcours de l’arrivée jusqu’à l’objectif : un contact, un achat, un abonnement, une installation.",
      "cle": "tunnel"
    },
    {
      "terme": "Abandon de panier",
      "def": "Un visiteur remplit son panier, puis quitte le site sans payer.",
      "cle": "abandon"
    },
    {
      "terme": "Honeycomb",
      "def": "Modèle de Peter Morville qui décrit une bonne expérience en sept facettes.",
      "cle": "honeycomb"
    },
    {
      "terme": "Design system",
      "def": "Les règles, composants et modèles réutilisables qui rendent un produit cohérent. Les variables (couleurs, polices, rayons, espacements) en sont les fondations.",
      "cle": "design-system"
    },
    {
      "terme": "Friction",
      "def": "Tout ce qui demande un effort inutile pour décider ou pour atteindre un élément.",
      "cle": "hick"
    },
    {
      "terme": "Loi de Hick",
      "def": "À conditions comparables, plus il y a d’options à examiner, plus la décision peut prendre du temps.",
      "cle": "hick"
    },
    {
      "terme": "Loi de Fitts",
      "def": "Une cible petite et éloignée est plus longue à atteindre.",
      "cle": "fitts"
    },
    {
      "terme": "Accessibilité",
      "def": "Un produit utilisable par toute la cible, y compris avec une limitation visuelle, auditive ou motrice.",
      "cle": "accessibilite"
    },
    {
      "terme": "Texte alternatif",
      "def": "Description d’une image informative, lue par les lecteurs d’écran. Une image décorative reçoit un texte alternatif vide, pour être ignorée.",
      "cle": "accessibilite"
    },
    {
      "terme": "Contraste",
      "def": "Écart de luminosité entre un texte et son fond. Le seuil courant est de 4,5 pour 1.",
      "cle": "contraste"
    },
    {
      "terme": "Lecteur d’écran",
      "def": "Logiciel qui lit à voix haute ce qui s’affiche, utilisé notamment par les personnes aveugles ou malvoyantes.",
      "cle": "accessibilite"
    },
    {
      "terme": "Focus visible",
      "def": "Contour qui montre quel élément est atteint au clavier, par exemple le bouton « Payer ».",
      "cle": "accessibilite"
    },
    {
      "terme": "Accessibility Act",
      "nom": "European Accessibility Act",
      "def": "Directive européenne qui impose l’accessibilité à de nombreux produits et services numériques depuis le 28 juin 2025.",
      "cle": "loi"
    },
    {
      "terme": "Carte de chaleur",
      "nom": "Carte de chaleur (heatmap)",
      "def": "Visualisation des clics, du défilement ou d’autres interactions agrégées, selon la carte choisie.",
      "cle": "hotjar"
    },
    {
      "terme": "Microcopie",
      "def": "Les petits textes d’une interface : boutons, messages d’erreur, aides.",
      "cle": "microcopie"
    },
    {
      "terme": "Performance perçue",
      "def": "La vitesse ressentie par l’utilisateur, qui peut différer de la vitesse réelle.",
      "cle": "attente"
    },
    {
      "terme": "Performance réelle",
      "def": "Les délais et ressources mesurés pour charger le produit et exécuter les actions, dans des conditions précisées.",
      "cle": "performance-reelle"
    },
    {
      "terme": "Cache",
      "def": "Stockage temporaire d’un fichier ou d’un résultat pour le réutiliser. Il faut définir quand le renouveler pour garder les données à jour.",
      "cle": "performance-reelle"
    },
    {
      "terme": "Redis",
      "def": "Un stockage de données en mémoire, utilisable notamment comme cache côté serveur. Ce n’est pas une solution obligatoire pour accélérer un produit.",
      "cle": "performance-reelle"
    },
    {
      "terme": "Skeleton loader",
      "def": "Silhouette grise de la page, affichée pendant le chargement.",
      "cle": "attente"
    },
    {
      "terme": "MCP",
      "nom": "MCP (Model Context Protocol)",
      "def": "Un protocole commun pour relier une application d’IA à des outils et à des données, selon les connexions et les autorisations disponibles.",
      "cle": "mcp"
    },
    {
      "terme": "Autocomplétion",
      "def": "Des suggestions proposées pendant la saisie, à choisir d’un clic ou au clavier.",
      "cle": "form-photon"
    },
    {
      "terme": "Audit",
      "def": "Contrôle d’un site, par un outil ou par une personne, pour lister ce qui ne va pas.",
      "cle": "rapport"
    },
    {
      "terme": "Agent IA",
      "def": "Une IA qui peut enchaîner des actions pour une mission avec des outils et des autorisations. Ses actions et leurs résultats restent à vérifier.",
      "cle": "agent"
    },
    {
      "terme": "API",
      "nom": "API (Application Programming Interface)",
      "def": "Une interface qui permet à un logiciel d’utiliser des fonctions ou des données fournies par un autre logiciel.",
      "cle": "mcp"
    }
  ],
